<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spike tool for issue #191 part B: cuts the part of System.Private.CoreLib's IL that a listed type needs into a
       standalone assembly (see Program.cs). Not part of the compiler or the build. Mono.Cecil comes from the ILLink tasks
       package the SDK restores for trimming / PublishAot (~/.nuget/packages/microsoft.net.illink.tasks/<sdk version>). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IlLinkVersion>11.0.0-rc.2.26504.105</IlLinkVersion>
    <NuGetRoot>$(HOME)/.nuget/packages/</NuGetRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil" HintPath="$(NuGetRoot)microsoft.net.illink.tasks/$(IlLinkVersion)/tools/net/Mono.Cecil.dll" />
  </ItemGroup>
</Project>
