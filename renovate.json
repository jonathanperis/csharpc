{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 6am on monday"],
  "timezone": "America/Sao_Paulo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Roslyn is csharpc's front-end: one PR for all Microsoft.CodeAnalysis packages, always reviewed by hand",
      "matchPackageNames": ["Microsoft.CodeAnalysis*"],
      "groupName": "Roslyn",
      "automerge": false
    },
    {
      "description": ".NET SDK pin in global.json (csharpc tracks the newest SDK, previews included)",
      "matchFileNames": ["global.json"],
      "ignoreUnstable": false,
      "automerge": false
    },
    {
      "description": "GitHub Actions minor/patch updates merge automatically once CI passes",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}
