<provider name="Demo-Shop" guid="{c9e45211-e262-5dcd-8495-5483d7acb7a1}" resourceFileName="shop.dll" messageFileName="shop.dll" symbol="DemoShop">
 <channels>
  <channel chid="Debug" name="Demo-Shop/Debug" value="19" type="Debug" enabled="false"/>
 </channels>
 <tasks>
  <task name="Checkout" message="$(string.task_Checkout)" value="1"/>
  <task name="Helper" message="$(string.task_Helper)" value="65529"/>
  <task name="CheckoutStop" message="$(string.task_CheckoutStop)" value="65530"/>
  <task name="Checkout" message="$(string.task_Checkout)" value="65531"/>
  <task name="OrderPlaced" message="$(string.task_OrderPlaced)" value="65533"/>
  <task name="EventSourceMessage" message="$(string.task_EventSourceMessage)" value="65534"/>
 </tasks>
 <maps>
  <valueMap name="Payment">
   <map value="0x1" message="$(string.map_Payment.Card)"/>
   <map value="0x2" message="$(string.map_Payment.Cash)"/>
   <map value="0x4" message="$(string.map_Payment.Voucher)"/>
  </valueMap>
  <bitMap name="Flags">
   <map value="0x1" message="$(string.map_Flags.Gift)"/>
   <map value="0x2" message="$(string.map_Flags.Express)"/>
  </bitMap>
 </maps>
 <opcodes>
  <opcode name="Validate" message="$(string.opcode_Validate)" value="11"/>
 </opcodes>
 <keywords>
  <keyword name="Orders" message="$(string.keyword_Orders)" mask="0x1"/>
  <keyword name="Payments" message="$(string.keyword_Payments)" mask="0x2"/>
  <keyword name="Session3" message="$(string.keyword_Session3)" mask="0x100000000000"/>
  <keyword name="Session2" message="$(string.keyword_Session2)" mask="0x200000000000"/>
  <keyword name="Session1" message="$(string.keyword_Session1)" mask="0x400000000000"/>
  <keyword name="Session0" message="$(string.keyword_Session0)" mask="0x800000000000"/>
 </keywords>
 <events>
  <event value="0" version="0" level="win:LogAlways" symbol="EventSourceMessage" task="EventSourceMessage" template="EventSourceMessageArgs"/>
  <event value="1" version="0" level="win:Informational" symbol="OrderPlaced" message="$(string.event_OrderPlaced)" keywords="Orders" task="OrderPlaced" template="OrderPlacedArgs"/>
  <event value="2" version="0" level="win:Warning" symbol="PaymentChecked" keywords="Payments" opcode="Validate" task="Checkout" template="PaymentCheckedArgs"/>
  <event value="3" version="2" level="win:Verbose" symbol="CheckoutStart" opcode="win:Start" task="Checkout" channel="Debug" template="CheckoutStartArgs"/>
  <event value="4" version="0" level="win:Informational" symbol="CheckoutStop" opcode="win:Stop" task="CheckoutStop" template="CheckoutStopArgs"/>
  <event value="5" version="0" level="win:Informational" symbol="Helper" task="Helper" template="HelperArgs"/>
 </events>
 <templates>
  <template tid="EventSourceMessageArgs">
   <data name="message" inType="win:UnicodeString"/>
  </template>
  <template tid="OrderPlacedArgs">
   <data name="id" inType="win:UnicodeString"/>
   <data name="items" inType="win:Int32"/>
  </template>
  <template tid="PaymentCheckedArgs">
   <data name="kind" inType="win:UInt32" map="Payment"/>
   <data name="flags" inType="win:UInt32" map="Flags"/>
   <data name="amount" inType="win:Double"/>
  </template>
  <template tid="CheckoutStartArgs">
   <data name="cart" inType="win:Int64"/>
   <data name="member" inType="win:Boolean"/>
   <data name="session" inType="win:GUID"/>
  </template>
  <template tid="CheckoutStopArgs">
   <data name="receiptSize" inType="win:UInt32"/>
   <data name="receipt" inType="win:Binary" length="receiptSize"/>
  </template>
  <template tid="HelperArgs">
   <data name="x" inType="win:Int32"/>
  </template>
 </templates>
</provider>
</events>
</instrumentation>
