[a-z]+                     => 'ello' 'rld' 'x' 'y' 'tab'
[^a-zA-Z\s]+               => ',' 'ö' '!' 'ÀÉÎ' '123' '٣٤' 'αβγ' 'ΔΣ' '_' '-'
[a-z-[aeiou]]+             => 'll' 'rld' 'x' 'y' 't' 'b'
[\w-[\d_]]+                => 'Hello' 'Wörld' 'ÀÉÎ' 'αβγ' 'ΔΣ' 'x' 'y' 'tab'
[a-z-[d-f-[e]]]+           => 'abc' 'e' 'gh'
\d+                        => '123' '٣٤'
\d+                        => '123'
\w+                        => 'Hello' 'W' 'rld' '123' '_x' 'y' 'tab'
\W+                        => '-' ' '
\s+                        => ' 	
 '
\S+                        => 'a' 'b'
\p{Lu}+                    => 'H' 'W' 'ÀÉÎ' 'ΔΣ'
\p{Ll}+                    => 'ello' 'örld' 'αβγ' 'x' 'y' 'tab'
\p{L}+                     => 'Hello' 'Wörld' 'ÀÉÎ' 'αβγ' 'ΔΣ' 'x' 'y' 'tab'
\P{L}+                     => '12'
\p{N}+                     => '123' '٣٤'
\p{Nd}                     => '1' '2' '3' '٣' '٤'
\p{P}                      => ',' '!' '_' '-'
\p{IsGreek}+               => 'αβγ' 'ΔΣ'
\p{IsGreekandCoptic}+      => 'αβγ' 'ΔΣ'
\p{IsBasicLatin}+          => 'abc ' ' d'
[\p{Lu}\d]+                => 'H' 'W' 'ÀÉÎ' '123' '٣٤' 'ΔΣ'
[^\p{L}\s]+                => ',' '!' '123' '٣٤' '_' '-'
[\]\[\\\-^]+               => '[' ']' '\' '-' '^'
[]a]+                      => ']a]'
[a\-z]+                    => 'a-z'
[.+*?]+                    => '.+*?'
[\x41-\x43a]+              => 'ABC' 'a'
[\t ]+                     => '	 '
[\b]                       => ''
\x41B\103\cA               => 'ABC'
.                          => 'a' 'b'
[^\n]+                     => 'line1' 'line2'
\p{Sc}                     => '$' '€' '£'
[\p{Pd}\p{Ps}\p{Pe}]       => '-' '(' ')' '[' ']'
