hello              IgnoreCase                   => 'Hello' 'HELLO' 'hello' 'hElLo'
[a-c]+             IgnoreCase                   => 'ABC' 'abc' 'AbC'
[^a-z]+            IgnoreCase                   => '123'
\w+                IgnoreCase                   => '\u00C0\u00C9\u00CE' '\u00E0\u00E9\u00EE'
é                  IgnoreCase                   => '\u00C9' '\u00E9'
k                  IgnoreCase                   => 'K' 'k' '\u212A'
K                  IgnoreCase                   => 'K' 'k' '\u212A'
[k-l]              IgnoreCase                   => 'K' 'L' '\u212A'
σ                  IgnoreCase                   => '\u03A3' '\u03C3'
i                  IgnoreCase                   => 'I' 'i'
I                  IgnoreCase                   => 'I' 'i'
i                  IgnoreCase, CultureInvariant => 'I' 'i'
ss                 IgnoreCase                   => 'SS' 'ss'
(\w)\1             IgnoreCase                   => 'aA' 'Bb' 'cc'
(?<c>[a-z])\k<c>   IgnoreCase                   => 'xX' 'yy'
a(?i)b(?-i)c       None                         => 'aBc' 'abc'
a(?i:b)c           None                         => 'aBc'
(?i)straße         None                         => 'Stra\u00DFe' 'STRA\u1E9EE'
ǅ                  IgnoreCase                   => '\u01C4' '\u01C5' '\u01C6'
[α-ω]+             IgnoreCase                   => '\u0391\u0392\u0393' '\u03B1\u03B2\u03B3'
Ꭰ                  IgnoreCase                   => '\u13A0' '\uAB70'
False True
Hell0 W0rld
