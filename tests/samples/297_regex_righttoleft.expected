\d+            12 345 6         => [7:'6'] [3:'345'] [0:'12']
\d+?           12 345           => [5:'5'] [4:'4'] [3:'3'] [1:'2'] [0:'1']
(\w)(\d)       a1b2c3           => [4:'c3' 'c' '3'] [2:'b2' 'b' '2'] [0:'a1' 'a' '1']
\d+            12 345 6         => [3:'34'] [0:'12']
a.*b           axbxb            => [0:'axbxb']
(?<=a)b        abab cb          => [3:'b'] [1:'b']
b(?=c)         bc bd bc         => [6:'b'] [0:'b']
^\w+|\w+$      one two three    => [8:'three'] [0:'one']
(a)\1          aa ba aa         =>
\1(a)          aa ba aa         => [6:'aa' 'a'] [0:'aa' 'a']
x*             axxb             => [4:''] [1:'xx'] [1:''] [0:'']
(?i)AB         ab Ab aB         => [6:'aB'] [3:'Ab'] [0:'ab']
