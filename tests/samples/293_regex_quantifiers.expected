<.+>               <a><b>             => [0:'<a><b>']
<.+?>              <a><b>             => [0:'<a>'] [3:'<b>']
a{2}               aaaaa              => [0:'aa'] [2:'aa']
a{2,}              a aa aaaa          => [2:'aa'] [5:'aaaa']
a{1,3}             aaaaaaa            => [0:'aaa'] [3:'aaa'] [6:'a']
a{1,3}?            aaaa               => [0:'a'] [1:'a'] [2:'a'] [3:'a']
a{0}b              ab b               => [1:'b'] [3:'b']
x??y               xy y               => [0:'xy'] [3:'y']
(ab)*c             ababc abc c        => [0:'ababc' 1='ab'#2] [6:'abc' 1='ab'#1] [10:'c' 1=''#0]
(a|b)*?c           abac               => [0:'abac' 1='a'#3]
(?>a+)ab           aaab               =>
(?>a+)b            aaab               => [0:'aaab']
(a+)+b             aaab aab           => [0:'aaab' 1='aaa'#1] [5:'aab' 1='aa'#1]
(a*)*              aa                 => [0:'aa' 1=''#2] [2:'' 1=''#1]
(a*)+              b                  => [0:'' 1=''#1] [1:'' 1=''#1]
(a?)*?x            aax                => [0:'aax' 1='a'#2]
(\w+?)(\d*)$       abc123             => [0:'abc123' 1='abc'#1 2='123'#1]
\d{2,3}?\d         12345              => [0:'123']
(?:a{2}){2}        aaaaa              => [0:'aaaa']
[ab]{3,}?c         ababc              => [0:'ababc']
(\s*,\s*)+         a , ,b             => [1:' , ,' 1=','#2]
(?:(a)|b)+         aba                => [0:'aba' 1='a'#2]
\b\w{4}\b          this word is long enough => [0:'this'] [5:'word'] [13:'long']
a{,2}              a{,2}              => [0:'a{,2}']
