<Project Sdk="Microsoft.NET.Sdk">
  <!-- `dynamic` in a library consumed as IL: csc compiled it to Microsoft.CSharp call sites, which csharpc
       rejects explicitly (it binds dynamic operations from C# source only; docs/adr/0019-dynamic.md). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
