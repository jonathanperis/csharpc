<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built without a PDB, like most NuGet packages as they reach an app's output: .NET names its frames
       but prints no " in file:line N" for them. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
