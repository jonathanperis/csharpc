<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="IlResources">
      <HintPath>../IlResources/bin/Release/net11.0/IlResources.dll</HintPath>
    </Reference>
    <!-- runtimeconfig.json configProperties, seen through AppContext -->
    <RuntimeHostConfigurationOption Include="IlResources.Verbose" Value="true" />
    <RuntimeHostConfigurationOption Include="IlResources.Limit" Value="42" />
  </ItemGroup>
</Project>
