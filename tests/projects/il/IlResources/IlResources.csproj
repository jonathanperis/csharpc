<Project Sdk="Microsoft.NET.Sdk">
  <!-- Messages from an embedded .resx (IlResources.Strings.resources) through ResourceManager, as
       libraries' SR classes and Properties.Resources do; a runtimeconfig switch read with AppContext. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- A raw manifest resource (IlResources.table.dat), read with Assembly.GetManifestResourceStream. -->
    <EmbeddedResource Include="table.dat" />
    <!-- A .resources file written with ResourceWriter (primitives by type code, a byte array, Stream entries): ResourceManager.GetResourceSet / GetStream. -->
    <EmbeddedResource Include="Blobs.resources" LogicalName="IlResources.Blobs.resources" />
  </ItemGroup>
</Project>
