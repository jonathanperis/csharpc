<Project Sdk="Microsoft.NET.Sdk">
  <!-- IL idioms Roslyn's own assemblies use (M6, docs/18-compatibility.md#roslyn-and-csharpc): built by
       tests/il.sh, consumed as a DLL. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Assembly attributes read back with Assembly.GetCustomAttribute<T>() (compile-time metadata). -->
    <InformationalVersion>4.5.6-preview.7</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>4.5.6.789</FileVersion>
    <Company>csharpc tests</Company>
    <Product>IL idioms</Product>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="CommitHash" Value="0123abcd" />
  </ItemGroup>
</Project>
