<Project Sdk="Microsoft.NET.Sdk">
  <!-- Microsoft.Extensions.Primitives change tokens (compiled from the shared framework's IL) over
       CancellationTokenSource registrations (corelib/Cancellation.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
