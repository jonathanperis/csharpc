<Project Sdk="Microsoft.NET.Sdk">
  <!-- csharpc folds ProjectReferences into one program, but C# checks every project on its own:
       definite assignment is relaxed for structs from another assembly (CS8882 is only a warning),
       and each project keeps its own DefineConstants. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <DefineConstants>$(DefineConstants);APP_ONLY</DefineConstants>
    <NoWarn>$(NoWarn);CS8882</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ProjectRefsLib/ProjectRefsLib.csproj" />
  </ItemGroup>
</Project>
