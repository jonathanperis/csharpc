<Project Sdk="Microsoft.NET.Sdk">
  <!-- A library with a source-generated System.Text.Json context of its own (the JSON generator runs on this
       project's compilation), referenced by an app with contexts and reflection-style calls of its own. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
