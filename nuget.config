<?xml version="1.0" encoding="utf-8"?>
<!-- csharpc binds C# with the same Roslyn build as the pinned .NET SDK's csc (global.json), which ships
     before nuget.org gets it: Microsoft.CodeAnalysis* comes from dnceng's public dotnet-tools feed,
     everything else from nuget.org only (package source mapping). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
