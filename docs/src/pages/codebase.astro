---
import Base from '../layouts/Base.astro';
import { measure, squarify } from '../lib/codebase';

const areas = measure();
const total = areas.reduce((s, a) => s + a.lines, 0);
const fmt = (n: number) => n.toLocaleString('en-US');
const pct = (n: number, of = total) => `${((100 * n) / of).toFixed(1)} %`;

// One hue per area; its leaves step from dark to light so neighbours stay apart. Light text on all of them.
const hues: Record<string, number> = { codegen: 262, frontend: 200, runtime: 18, corelib: 152, tests: 42, support: 330 };
const color = (key: string, i: number, n: number) => `hsl(${hues[key]} 52% ${30 + (n > 1 ? (i / (n - 1)) * 20 : 0)}%)`;

const W = 1200, H = 680, pad = 3;
const blocks = squarify(areas, (a) => a.lines, { x: 0, y: 0, w: W, h: H });
const tiles = blocks.flatMap((b) => {
  const inner = { x: b.x + pad, y: b.y + pad + 22, w: Math.max(0, b.w - 2 * pad), h: Math.max(0, b.h - 2 * pad - 22) };
  return squarify(b.leaves, (l) => l.lines, inner).map((l, i) => ({ ...l, area: b, fill: color(b.key, i, b.leaves.length) }));
});
// Labels only where they fit; every tile still has a hover title.
const fits = (w: number, h: number, text: string, size: number) => w > text.length * size * 0.56 + 10 && h > size * 2.6;
---
<Base title="Codebase" current="codebase" description="How csharpc's source is split across its responsibilities, counted when the site is built.">
  <main class="page">
    <section class="hero" style="padding-bottom: 20px">
      <h1>The codebase, by <span>responsibility</span></h1>
      <p>
        {fmt(total)} lines of source, tests and tooling, counted from the repository when this site was built.
        Each rectangle's area is proportional to its line count. Hover a tile for its numbers.
      </p>
    </section>

    <svg class="treemap" viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Treemap of csharpc's lines of code by area and responsibility">
      {tiles.map((t) => (
        <g>
          <title>{`${t.area.name} › ${t.name}: ${fmt(t.lines)} lines in ${fmt(t.files)} files (${pct(t.lines)} of all, ${pct(t.lines, t.area.lines)} of ${t.area.name})`}</title>
          <rect class="leaf" x={t.x} y={t.y} width={t.w} height={t.h} fill={t.fill} />
          {fits(t.w, t.h, t.name, 13) && (
            <>
              <text x={t.x + 7} y={t.y + 18} font-size="13" font-weight="600" fill="#fff">{t.name}</text>
              <text x={t.x + 7} y={t.y + 34} font-size="12" fill="#fff" fill-opacity="0.8">{fmt(t.lines)}</text>
            </>
          )}
        </g>
      ))}
      {blocks.map((b) => (
        <g>
          <rect x={b.x + pad} y={b.y + pad} width={Math.max(0, b.w - 2 * pad)} height="22" fill={`hsl(${hues[b.key]} 45% 22%)`} />
          {fits(b.w, 40, b.name, 13) && <text x={b.x + pad + 7} y={b.y + pad + 15.5} font-size="13" font-weight="700" fill="#fff">{b.name} · {pct(b.lines)}</text>}
          <rect class="area" x={b.x} y={b.y} width={b.w} height={b.h} />
        </g>
      ))}
    </svg>
    <ul class="legend">
      {areas.map((a) => <li><i style={`background: hsl(${hues[a.key]} 52% 38%)`}></i>{a.name} <span class="note">{fmt(a.lines)}</span></li>)}
    </ul>

    <div class="areas">
      {areas.map((a) => (
        <section class="area-card" id={a.key}>
          <h3>{a.name}<small>{fmt(a.lines)} · {pct(a.lines)}</small></h3>
          <p>{a.summary}</p>
          <ul class="bars">
            {a.leaves.map((l, i) => (
              <li>
                <span>{l.name}</span><em>{fmt(l.lines)}</em>
                <div class="bar"><span style={`width: ${(100 * l.lines) / a.leaves[0].lines}%; background: ${color(a.key, i, a.leaves.length)}`}></span></div>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <h2 class="section-title">How this is counted</h2>
    <p class="note">
      Lines are physical lines of every <code>.cs</code>, <code>.c</code>/<code>.h</code>, script, workflow and Markdown file,
      with build output skipped. Each file goes to one responsibility by its directory and, inside the code generator,
      the C runtime and the corelib, by its file name: the code generator is one <code>FunctionCodeGen.&lt;Feature&gt;.cs</code>
      partial per feature area, so the file name says what it lowers. The ICU shim is .NET's own globalization native code,
      carried so cultures work without .NET installed. Generated IL slices and recorded <code>.expected</code> outputs are not counted.
      The classification lives in <a href="https://github.com/jonathanperis/csharpc/blob/main/docs/src/lib/codebase.ts"><code>docs/src/lib/codebase.ts</code></a>.
    </p>
  </main>
</Base>
