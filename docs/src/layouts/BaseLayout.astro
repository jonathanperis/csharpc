---
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'csharpc | C# TO NATIVE THROUGH LLVM',
  description = 'csharpc is an LLVM front-end for C#: it compiles C# source and .NET IL to small, fast, hardened native executables, as a standalone compiler or as the AOT layer behind PublishAot.',
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const assetPath = (path: string) => `${basePath}${path.replace(/^\//, '')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'csharpc',
  description,
  url: pageUrl,
  codeRepository: 'https://github.com/jonathanperis/csharpc',
  programmingLanguage: ['C#', 'C'],
  runtimePlatform: 'Native (LLVM 18) / WebAssembly (WASI)',
  license: 'https://github.com/jonathanperis/csharpc/blob/main/LICENSE',
  author: { '@type': 'Person', name: 'Jonathan Peris', url: 'https://github.com/jonathanperis' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={assetPath('favicon.svg')} />
    <meta name="description" content={description} />
    <meta name="keywords" content="C#, LLVM, compiler, NativeAOT, AOT, Roslyn, .NET, native executable, WebAssembly" />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#178600" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="csharpc" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
