---
import '../styles/site.css';

interface Props { title: string; description?: string; current?: 'home' | 'docs' | 'codebase'; menu?: boolean }
const { title, description = 'csharpc: an LLVM front-end for C# that compiles C# and .NET IL to native executables.', current, menu = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title === 'csharpc' ? title : `${title} · csharpc`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      {menu && <button class="menu-toggle" aria-label="Documents" onclick="document.body.classList.toggle('menu-open')">☰</button>}
      <a class="brand" href={`${base}/`}><span class="brand-mark">C#</span>csharpc</a>
      <nav class="site-nav">
        <a href={`${base}/docs/`} aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
        <a href={`${base}/codebase/`} aria-current={current === 'codebase' ? 'page' : undefined}>Codebase</a>
        <a class="wide" href={`${base}/docs/06-roadmap/`}>Roadmap</a>
        <a class="wide" href="https://github.com/jonathanperis/csharpc">GitHub</a>
        <button class="theme-toggle" aria-label="Toggle dark mode" id="theme-toggle">◐</button>
      </nav>
    </header>
    <slot />
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
