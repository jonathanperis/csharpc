<?xml version="1.0" encoding="utf-8"?>
<!-- TechEmpower's file, plus a cleared packageSourceMapping: the repository's nuget.config maps every
     package to its "nuget.org" source key, which the <clear /> below removes. -->
<configuration>
  <packageSources>
    <clear />
    <add key="NuGet" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
