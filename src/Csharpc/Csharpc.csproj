<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>csharpc</AssemblyName>
    <RootNamespace>Csharpc</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The SDK's regex generator looks a culture up by name ([GeneratedRegex(..., "tr-TR")]) to pick its case behaviour,
         which only needs the name; without this, invariant mode throws ArgumentException("cultureName") for any name. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- csharpc's own native build (tools/bootstrap/selfhost.sh) takes System.Linq's size-optimized path: the speed-optimized
         one's per-shape iterators, instantiated for every element type csharpc uses, make the self-compile exceed the CI
         runner's memory. User programs get .NET's default for their kind (ADR 0023, Linq row). -->
    <UseSizeOptimizedLinq>true</UseSizeOptimizedLinq>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- `dotnet pack` => a .NET tool: dotnet tool install -g csharpc -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>csharpc</ToolCommandName>
    <PackageId>csharpc</PackageId>
    <Version>0.1.0-alpha</Version>
    <Description>csharpc: a C# compiler front-end for LLVM (Roslyn -> LLVM IR -> native).</Description>
    <Authors>csharpc contributors</Authors>
    <PackageProjectUrl>https://github.com/jonathanperis/csharpc</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jonathanperis/csharpc</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      RID-specific NativeAOT tool packages (SDK 10+/11): opted in only when packing for release
      (-p:CsharpcPackRidTools=true -p:PublishAot=true). Plain `dotnet pack` stays the classic
      framework-dependent tool. See tools/pack-release.sh and docs/08-drop-in.md.
    -->
    <ToolPackageRuntimeIdentifiers Condition="'$(CsharpcPackRidTools)' == 'true'">linux-x64;linux-arm64;osx-arm64;win-x64</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers Condition="'$(CsharpcPackRidTools)' == 'true'">linux-x64;linux-arm64;osx-arm64;win-x64</RuntimeIdentifiers>
    <!-- Drop the large .dbg next to the AOT binary from the tool package and release archive. -->
    <StripSymbols Condition="'$(PublishAot)' == 'true'">true</StripSymbols>

    <!-- csharpc is a short-lived process: dynamic PGO's instrumented tier costs more than it gains (ADR 0014). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0-1.26555.108" />
  </ItemGroup>

  <!--
    The SDK's own source generators for [JsonSerializable], [LibraryImport] and [GeneratedRegex], linked into csharpc instead of loaded at
    run time (SourceGenerators.cs): a csharpc compiled by csharpc cannot load assemblies. They come from the analyzers
    folder of the Microsoft.NETCore.App.Ref pack of the SDK that builds csharpc (version pinned by the SDK,
    global.json), so they are the generators `dotnet build` runs for the same .NET. Microsoft.Interop.SourceGeneration
    is the shared library of LibraryImportGenerator. Generators of projects (analyzers from NuGet, Razor) stay dynamic.
  -->
  <PropertyGroup>
    <_CsharpcSdkGenerators>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/analyzers/dotnet/cs</_CsharpcSdkGenerators>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Text.Json.SourceGeneration" Aliases="JsonGenerator" HintPath="$(_CsharpcSdkGenerators)/System.Text.Json.SourceGeneration.dll" />
    <Reference Include="System.Text.RegularExpressions.Generator" Aliases="RegexGenerator" HintPath="$(_CsharpcSdkGenerators)/System.Text.RegularExpressions.Generator.dll" />
    <Reference Include="Microsoft.Interop.LibraryImportGenerator" HintPath="$(_CsharpcSdkGenerators)/Microsoft.Interop.LibraryImportGenerator.dll" />
    <Reference Include="Microsoft.Interop.SourceGeneration" HintPath="$(_CsharpcSdkGenerators)/Microsoft.Interop.SourceGeneration.dll" />
  </ItemGroup>

  <!-- The C runtime (csrt) ships next to the compiler and is compiled/linked on demand. -->
  <ItemGroup>
    <Compile Remove="corelib/**" />
    <None Include="corelib/**/*.cs" LinkBase="corelib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../runtime/**/*.c;../runtime/**/*.h" LinkBase="runtime" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Release packs bundle libLLVM next to the NativeAOT binary (lib/), so `dotnet tool install -g csharpc`
    yields the same layout as the GitHub Release archives. Path from $CSHARPC_LIBLLVM or -p:CsharpcLibLLVM=.
  -->
  <!-- CsharpcBundleLibLLVM=true only from tools/pack-release.sh (per-RID AOT). The pointer pack
       (tools/pack-tool-pointer.sh) must not require libLLVM or rebuild RID packages. -->
  <Target Name="CsharpcBundleLibLLVM" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CsharpcBundleLibLLVM)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <_CsharpcLibLLVM>$(CsharpcLibLLVM)</_CsharpcLibLLVM>
      <_CsharpcLibLLVM Condition="'$(_CsharpcLibLLVM)' == ''">$(CSHARPC_LIBLLVM)</_CsharpcLibLLVM>
      <_CsharpcLibLLVMDest Condition="$(RuntimeIdentifier.StartsWith('win'))">lib/libLLVM-18.dll</_CsharpcLibLLVMDest>
      <_CsharpcLibLLVMDest Condition="$(RuntimeIdentifier.StartsWith('osx'))">lib/libLLVM.dylib</_CsharpcLibLLVMDest>
      <_CsharpcLibLLVMDest Condition="'$(_CsharpcLibLLVMDest)' == ''">lib/libLLVM.so.18.1</_CsharpcLibLLVMDest>
    </PropertyGroup>
    <Error Condition="'$(_CsharpcLibLLVM)' == '' or !Exists('$(_CsharpcLibLLVM)')"
           Text="csharpc: set CSHARPC_LIBLLVM (or -p:CsharpcLibLLVM=) to libLLVM 18 when packing RID tools; missing '$(_CsharpcLibLLVM)'." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(_CsharpcLibLLVM)" RelativePath="$(_CsharpcLibLLVMDest)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="CsharpcFinishLibLLVM" AfterTargets="Publish"
          Condition="'$(CsharpcBundleLibLLVM)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <MakeDir Directories="$(PublishDir)lib" />
    <Copy Condition="$(RuntimeIdentifier.StartsWith('linux')) and Exists('$(PublishDir)lib/libLLVM.so.18.1')"
          SourceFiles="$(PublishDir)lib/libLLVM.so.18.1" DestinationFiles="$(PublishDir)lib/libLLVM-18.so"
          SkipUnchangedFiles="true" />
    <!-- Redistribution needs the license texts, not links: libLLVM (Apache-2.0 with LLVM exceptions), the
         bundled .NET reference assemblies and Roslyn (MIT), csharpc's own license and notices. -->
    <ItemGroup>
      <_CsharpcLicense Include="$(MSBuildThisFileDirectory)../../licenses/*.TXT;$(MSBuildThisFileDirectory)../../LICENSE;$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" />
    </ItemGroup>
    <Copy SourceFiles="@(_CsharpcLicense)" DestinationFolder="$(PublishDir)licenses" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../licenses/LLVM-LICENSE.TXT" DestinationFolder="$(PublishDir)lib" SkipUnchangedFiles="true" />
  </Target>

  <!-- Bundle Microsoft.NETCore.App.Ref/net11.0 so NativeAOT installs bind without an SDK. -->
  <Target Name="CsharpcBundleRefPack" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CsharpcBundleRefPack)' != '' and '$(RuntimeIdentifier)' != ''">
    <Error Condition="!Exists('$(CsharpcBundleRefPack)')"
           Text="csharpc: CsharpcBundleRefPack directory missing: $(CsharpcBundleRefPack)" />
    <ItemGroup>
      <_CsharpcRefDll Include="$(CsharpcBundleRefPack)/*.dll" />
      <ResolvedFileToPublish Include="@(_CsharpcRefDll)" RelativePath="ref/net11.0/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    Bundle the shared framework's managed assemblies (shared/Microsoft.NETCore.App/<version>, its *.dll only: no native
    runtime) so NativeAOT installs compile from the framework's IL without a .NET installation (#375): the libraries served
    from IL (System.Linq, System.Text.Json, Regex ...) are lowered from these. The same directory the slicer cut
    CsharpcUpstream.dll from (_CsharpcFrameworkDir), so the slice and the IL always match. Frontend/SharedFramework.cs
    looks for them next to the executable first. -p:CsharpcBundleSharedFramework=true (tools/pack-release.sh).
  -->
  <Target Name="CsharpcBundleSharedFramework" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(CsharpcBundleSharedFramework)' == 'true' and '$(RuntimeIdentifier)' != ''">
    <Error Condition="!Exists('$(_CsharpcFrameworkDir)System.Private.CoreLib.dll')"
           Text="csharpc: the shared framework to bundle is missing: $(_CsharpcFrameworkDir)" />
    <ItemGroup>
      <_CsharpcFrameworkDll Include="$(_CsharpcFrameworkDir)*.dll" />
      <ResolvedFileToPublish Include="@(_CsharpcFrameworkDll)" RelativePath="shared/Microsoft.NETCore.App/$(BundledNETCoreAppPackageVersion)/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!--
    ReadyToRun at build time (docs/adr/0014-compile-time.md). Every csharpc run used to JIT Roslyn's
    binder and parser and csharpc's code generator before compiling anything (~1-2 s of CPU per
    compile). Release builds (`dotnet build -c Release`, what the tests, the README and the Csharpc.Sdk
    package use) precompile csharpc.dll and the Roslyn assemblies with crossgen2 for the host, one
    assembly at a time and incrementally (Roslyn once, csharpc.dll in ~2 s after a change). The images
    replace the IL ones in the output and publish directories; they still run on any later runtime
    (ReadyToRun code is rejected and re-JIT-ed if it doesn't match). Opt out: -p:CsharpcReadyToRun=false.
  -->
  <PropertyGroup>
    <CsharpcReadyToRun Condition="'$(CsharpcReadyToRun)' == '' and '$(Configuration)' == 'Release' and '$(PublishAot)' != 'true' and '$(PublishReadyToRun)' != 'true'">true</CsharpcReadyToRun>
    <_CsharpcCrossgenRid>$(NETCoreSdkPortableRuntimeIdentifier)</_CsharpcCrossgenRid>
    <_CsharpcCrossgenRid Condition="'$(_CsharpcCrossgenRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_CsharpcCrossgenRid>
    <_CsharpcCrossgenOs>$(_CsharpcCrossgenRid.Split('-')[0])</_CsharpcCrossgenOs>
    <_CsharpcCrossgenOs Condition="'$(_CsharpcCrossgenOs)' == 'win'">windows</_CsharpcCrossgenOs>
    <_CsharpcCrossgenArch>$(_CsharpcCrossgenRid.Split('-')[1])</_CsharpcCrossgenArch>
    <_CsharpcCrossgenPackage>Microsoft.NETCore.App.Crossgen2.$(_CsharpcCrossgenRid)</_CsharpcCrossgenPackage>
    <_CsharpcFrameworkDir>$(NetCoreRoot)shared/Microsoft.NETCore.App/$(BundledNETCoreAppPackageVersion)/</_CsharpcFrameworkDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(CsharpcReadyToRun)' == 'true'">
    <PackageDownload Include="$(_CsharpcCrossgenPackage)" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>

  <Target Name="_CsharpcReadyToRunInputs">
    <PropertyGroup>
      <_CsharpcCrossgen>$(NuGetPackageRoot)$(_CsharpcCrossgenPackage.ToLowerInvariant())/$(BundledNETCoreAppPackageVersion)/tools/crossgen2</_CsharpcCrossgen>
      <_CsharpcCrossgen Condition="'$(OS)' == 'Windows_NT'">$(NuGetPackageRoot)$(_CsharpcCrossgenPackage.ToLowerInvariant())/$(BundledNETCoreAppPackageVersion)/tools/crossgen2.exe</_CsharpcCrossgen>
      <_CsharpcReadyToRunDir>$(ProjectDir)$(IntermediateOutputPath)r2r/</_CsharpcReadyToRunDir>
    </PropertyGroup>
    <ItemGroup>
      <_CsharpcReadyToRunInput Include="@(IntermediateAssembly->'%(FullPath)')" />
      <_CsharpcReadyToRunInput Include="@(ReferenceCopyLocalPaths->'%(FullPath)')"
                               Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
      <_CsharpcReadyToRunInput Update="@(_CsharpcReadyToRunInput)" OutputImage="$(_CsharpcReadyToRunDir)%(Filename)%(Extension)" RelativePath="%(Filename)%(Extension)" />
      <_CsharpcReadyToRunReference Include="@(ReferenceCopyLocalPaths->'%(FullPath)')"
                                   Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
    </ItemGroup>
  </Target>

  <Target Name="_CsharpcReadyToRunCompile" DependsOnTargets="_CsharpcReadyToRunInputs"
          Condition="'$(CsharpcReadyToRun)' == 'true'"
          Inputs="@(_CsharpcReadyToRunInput);$(ProjectAssetsFile)" Outputs="@(_CsharpcReadyToRunInput->'%(OutputImage)')">
    <!-- project.assets.json is an input too: package files keep their packed timestamps, so a newer
         package version (Roslyn 5.9 -> 5.12) looked older than the image built from the previous one. -->
    <Warning Condition="!Exists('$(_CsharpcCrossgen)') or !Exists('$(_CsharpcFrameworkDir)')"
             Text="csharpc: crossgen2 or the shared framework not found ($(_CsharpcCrossgen), $(_CsharpcFrameworkDir)); csharpc stays JIT-compiled (slower compiles)" />
    <MakeDir Directories="$(_CsharpcReadyToRunDir)" />
    <!-- One process per assembly; crossgen2 already compiles methods in parallel. -->
    <Exec Condition="Exists('$(_CsharpcCrossgen)') and Exists('$(_CsharpcFrameworkDir)')"
          Command="&quot;$(_CsharpcCrossgen)&quot; &quot;%(_CsharpcReadyToRunInput.Identity)&quot; -o:&quot;%(_CsharpcReadyToRunInput.OutputImage)&quot; --targetos:$(_CsharpcCrossgenOs) --targetarch:$(_CsharpcCrossgenArch) -O -r:&quot;$(_CsharpcFrameworkDir)*.dll&quot; @(_CsharpcReadyToRunReference->'-r:&quot;%(Identity)&quot;', ' ')"
          StandardOutputImportance="low" />
  </Target>

  <Target Name="_CsharpcReadyToRunImages" DependsOnTargets="_CsharpcReadyToRunCompile">
    <ItemGroup>
      <_CsharpcReadyToRunImage Include="@(_CsharpcReadyToRunInput->'%(OutputImage)')" Condition="Exists('%(_CsharpcReadyToRunInput.OutputImage)')" />
      <FileWrites Include="@(_CsharpcReadyToRunImage)" />
    </ItemGroup>
  </Target>

  <Target Name="_CsharpcReadyToRunBuild" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="_CsharpcReadyToRunImages"
          Condition="'$(CsharpcReadyToRun)' == 'true'">
    <Copy SourceFiles="@(_CsharpcReadyToRunImage)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    The types of System.Private.CoreLib served from the framework's own IL (upstream-types/*.txt, one file per library so flips of different
    libraries never edit the same file; ADR 0023, docs/21-ownership.md Part B): the
    slicer (tools/il-first/slicer) cuts what those types need out of the shared framework's CoreLib into CsharpcUpstream.dll, and writes
    CsharpcUpstream.map next to it; both ship beside the corelib sources and the compiler reads the map by default (Frontend/UpstreamSlice.cs).
    The slicer is built here and used here only: Mono.Cecil comes from the Microsoft.NET.ILLink.Tasks package (a PackageDownload, as crossgen2
    above), never from the compiler's references and never shipped. Incremental: it runs again only when the list, the slicer or the
    framework's CoreLib changed (a flip adds a file; one removed from the list needs a rebuild).
  -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.NET.ILLink.Tasks" Version="[$(BundledNETCoreAppPackageVersion)]" />
    <!-- The 32-bit CoreLib that wasm32's slice is cut from (#382): CoreLib is compiled per target, and the 64-bit one has its pointer size
         baked into the IL (TARGET_64BIT, IntPtr.Size folded by the trimmer). CoreCLR's linux-arm build: the same runtime-internal surface as the
         64-bit CoreLib the contract layer is written against (Mono's browser-wasm CoreLib differs there). Always the same version as the
         64-bit slice, never a floating one, and verified by signature with the signer pinned (nuget-signers.txt, _CsharpcVerifyCoreLib32Pack). -->
    <PackageDownload Include="Microsoft.NETCore.App.Runtime.linux-arm" Version="[$(BundledNETCoreAppPackageVersion)]" />
    <_CsharpcSlicerSource Include="../../tools/il-first/slicer/*.cs;../../tools/il-first/slicer/Slicer.csproj" />
    <_CsharpcUpstreamTypes Include="upstream-types/*.txt" />
  </ItemGroup>
  <PropertyGroup>
    <_CsharpcRefDir>$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/net11.0</_CsharpcRefDir>
    <_CsharpcCoreLibIl>$(_CsharpcFrameworkDir)System.Private.CoreLib.dll</_CsharpcCoreLibIl>
    <_CsharpcCoreLib32Package>microsoft.netcore.app.runtime.linux-arm</_CsharpcCoreLib32Package>
    <_CsharpcCoreLib32Dir>$(NuGetPackageRoot)$(_CsharpcCoreLib32Package)/$(BundledNETCoreAppPackageVersion)/</_CsharpcCoreLib32Dir>
    <_CsharpcCoreLib32Il>$(_CsharpcCoreLib32Dir)runtimes/linux-arm/lib/net11.0/System.Private.CoreLib.dll</_CsharpcCoreLib32Il>
    <_CsharpcCoreLib32Nupkg>$(_CsharpcCoreLib32Dir)$(_CsharpcCoreLib32Package).$(BundledNETCoreAppPackageVersion).nupkg</_CsharpcCoreLib32Nupkg>
    <_CsharpcPackHashes>$(MSBuildThisFileDirectory)runtime-pack-hashes.txt</_CsharpcPackHashes>
    <_CsharpcNuGetSigners>$(MSBuildThisFileDirectory)nuget-signers.txt</_CsharpcNuGetSigners>
  </PropertyGroup>

  <!-- The 32-bit pack is verified before anything is cut from it: its NuGet signature must be valid (integrity: the package is unchanged since
       it was signed) and its author signer one of the certificates pinned in nuget-signers.txt (Microsoft's), as NuGet's trustedSigners
       pins them; that survives SDK patch updates, which a pinned hash would not. runtime-pack-hashes.txt is an extra check: a line for the
       exact version must match, a missing one is not an error. A missing pack, a bad signature, another signer or a mismatching hash stops
       the build: a 32-bit target never falls back to the 64-bit slice (#382). -->
  <Target Name="_CsharpcVerifyCoreLib32Pack" Inputs="$(_CsharpcCoreLib32Nupkg);$(_CsharpcNuGetSigners);$(_CsharpcPackHashes)"
          Outputs="$(IntermediateOutputPath)corelib32.verified">
    <Error Condition="!Exists('$(_CsharpcCoreLib32Nupkg)') or !Exists('$(_CsharpcCoreLib32Il)')"
           Text="csharpc: the 32-bit runtime pack Microsoft.NETCore.App.Runtime.linux-arm $(BundledNETCoreAppPackageVersion) ($(_CsharpcCoreLib32Nupkg)) is needed to build wasm32's CoreLib slice (#382); restore it (dotnet restore src/Csharpc)" />
    <ReadLinesFromFile File="$(_CsharpcNuGetSigners)">
      <Output TaskParameter="Lines" ItemName="_CsharpcNuGetSignerLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CsharpcNuGetSigner Include="@(_CsharpcNuGetSignerLine)" Condition="!$([System.String]::Copy('%(Identity)').StartsWith('#'))" />
    </ItemGroup>
    <Error Condition="'@(_CsharpcNuGetSigner)' == ''" Text="csharpc: no signer fingerprint in $(_CsharpcNuGetSigners)" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; nuget verify --all &quot;$(_CsharpcCoreLib32Nupkg)&quot; @(_CsharpcNuGetSigner->'--certificate-fingerprint %(Identity)', ' ')"
          StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_CsharpcCoreLib32Verify" />
    </Exec>
    <Error Condition="'$(_CsharpcCoreLib32Verify)' != '0'"
           Text="csharpc: $(_CsharpcCoreLib32Nupkg) failed `dotnet nuget verify --all` against the signers pinned in $(_CsharpcNuGetSigners) (invalid or missing signature, a package changed since it was signed, or a signer that is not Microsoft's); refusing to cut wasm32's slice from it" />
    <GetFileHash Files="$(_CsharpcCoreLib32Nupkg)" Algorithm="SHA512" HashEncoding="base64">
      <Output TaskParameter="Hash" PropertyName="_CsharpcCoreLib32Hash" />
    </GetFileHash>
    <ReadLinesFromFile File="$(_CsharpcPackHashes)">
      <Output TaskParameter="Lines" ItemName="_CsharpcPackHashLine" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_CsharpcCoreLib32Pinned Include="@(_CsharpcPackHashLine)"
                               Condition="$([System.String]::Copy('%(Identity)').StartsWith('$(_CsharpcCoreLib32Package) $(BundledNETCoreAppPackageVersion) '))" />
    </ItemGroup>
    <Error Condition="'@(_CsharpcCoreLib32Pinned)' != '' and '@(_CsharpcCoreLib32Pinned)' != '$(_CsharpcCoreLib32Package) $(BundledNETCoreAppPackageVersion) $(_CsharpcCoreLib32Hash)'"
           Text="csharpc: $(_CsharpcCoreLib32Nupkg) does not match the SHA-512 listed for it in $(_CsharpcPackHashes) (got $(_CsharpcCoreLib32Hash)); refusing to cut wasm32's slice from it" />
    <!-- Verified once per package, signer list and hash list (incremental). -->
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Touch Files="$(IntermediateOutputPath)corelib32.verified" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)corelib32.verified" />
    </ItemGroup>
  </Target>

  <Target Name="CsharpcUpstreamSlice" AfterTargets="CopyFilesToOutputDirectory" DependsOnTargets="_CsharpcVerifyCoreLib32Pack"
          Inputs="@(_CsharpcSlicerSource);@(_CsharpcUpstreamTypes);$(_CsharpcCoreLibIl);$(_CsharpcCoreLib32Il);$(_CsharpcPackHashes);$(_CsharpcNuGetSigners);$(ProjectAssetsFile)"
          Outputs="$(OutDir)CsharpcUpstream.dll;$(OutDir)CsharpcUpstream.map;$(OutDir)upstream32/CsharpcUpstream.dll;$(OutDir)upstream32/CsharpcUpstream.map">
    <PropertyGroup>
      <_CsharpcSlicerDir>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)slicer/</_CsharpcSlicerDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CsharpcCoreLibIl)') or !Exists('$(_CsharpcRefDir)')"
           Text="csharpc: the shared framework's System.Private.CoreLib ($(_CsharpcCoreLibIl)) and the reference pack ($(_CsharpcRefDir)) are needed to build CsharpcUpstream.dll, the types served from the framework's IL (src/Csharpc/upstream-types/)" />
    <!-- (The package root passed without its trailing separator: on Windows `\&quot;` ends a quoted command-line argument and swallows the quote.) -->
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; build &quot;$(MSBuildThisFileDirectory)../../tools/il-first/slicer/Slicer.csproj&quot; -c Release -o &quot;$(_CsharpcSlicerDir)&quot; -p:NuGetRoot=&quot;$(NuGetPackageRoot.TrimEnd('\').TrimEnd('/'))&quot; -p:IlLinkVersion=$(BundledNETCoreAppPackageVersion) --nologo -v:q"
          StandardOutputImportance="low" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(_CsharpcSlicerDir)Slicer.dll&quot; emit --profile csharpc --roots-file &quot;$(MSBuildThisFileDirectory)upstream-types&quot; --corelib &quot;$(_CsharpcCoreLibIl)&quot; --ref &quot;$(_CsharpcRefDir)&quot; --shadows &quot;$(MSBuildThisFileDirectory)corelib&quot; --name CsharpcUpstream --out &quot;$(OutDir)CsharpcUpstream.dll&quot;"
          StandardOutputImportance="low" />
    <!-- The same roots and profile, cut from the 32-bit CoreLib: what 4-byte-pointer targets (wasm32) use (Frontend/UpstreamSlice.cs). It keeps
         the assembly name CsharpcUpstream (the corelib reaches the slice by that name: [UnsafeAccessorType]), in a directory of its own. -->
    <MakeDir Directories="$(OutDir)upstream32/" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(_CsharpcSlicerDir)Slicer.dll&quot; emit --profile csharpc --roots-file &quot;$(MSBuildThisFileDirectory)upstream-types&quot; --corelib &quot;$(_CsharpcCoreLib32Il)&quot; --ref &quot;$(_CsharpcRefDir)&quot; --shadows &quot;$(MSBuildThisFileDirectory)corelib&quot; --name CsharpcUpstream --out &quot;$(OutDir)upstream32/CsharpcUpstream.dll&quot;"
          StandardOutputImportance="low" />
    <!-- The exact pointer-size check (tools/il-first/slicer/PointerSize.cs): the members compiled differently for 32-bit targets, listed in
         obj/.../slicer/pointer-size.md, and a failure if the two slices do not serve the same types. -->
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(_CsharpcSlicerDir)Slicer.dll&quot; pointer-size &quot;$(OutDir)CsharpcUpstream.dll&quot; &quot;$(OutDir)upstream32/CsharpcUpstream.dll&quot; &quot;$(_CsharpcCoreLibIl)&quot; &quot;$(_CsharpcCoreLib32Il)&quot; &quot;$(_CsharpcSlicerDir)pointer-size.md&quot;"
          StandardOutputImportance="high" />
    <ItemGroup>
      <FileWrites Include="$(OutDir)CsharpcUpstream.dll;$(OutDir)CsharpcUpstream.map;$(OutDir)upstream32/CsharpcUpstream.dll;$(OutDir)upstream32/CsharpcUpstream.map" />
    </ItemGroup>
  </Target>

  <Target Name="_CsharpcUpstreamPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="CsharpcUpstreamSlice">
    <ItemGroup>
      <_CsharpcUpstreamFile Include="$(OutDir)CsharpcUpstream.dll;$(OutDir)CsharpcUpstream.map" />
      <ResolvedFileToPublish Include="@(_CsharpcUpstreamFile)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
      <_CsharpcUpstream32File Include="$(OutDir)upstream32/CsharpcUpstream.dll;$(OutDir)upstream32/CsharpcUpstream.map" />
      <ResolvedFileToPublish Include="@(_CsharpcUpstream32File)" RelativePath="upstream32/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <!-- dotnet publish (and the Csharpc.Sdk package, which publishes csharpc): the same images. -->
  <Target Name="_CsharpcReadyToRunPublish" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="_CsharpcReadyToRunImages"
          Condition="'$(CsharpcReadyToRun)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_CsharpcReadyToRunImage)" MatchOnMetadata="RelativePath" />
      <ResolvedFileToPublish Include="@(_CsharpcReadyToRunImage)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
